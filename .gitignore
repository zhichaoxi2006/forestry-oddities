# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Development runtime. ModDevGradle runs the game with ./run as its game directory (the IDE run
# configurations use $PROJECT_DIR$/run), so the world save, logs, generated config, copied-in mods
# and the whitelist/op/banned lists all live inside run/ and never in the repository root.
# `runs/` is ignored as well, for checkouts that use the runs/<name> layout.
run/
runs/
*.log

# IDE
.idea/
*.iml
*.ipr
*.iws
eclipse/
.vscode/
.settings/
.classpath
.project

# OS
Thumbs.db
.DS_Store

# Compat. The long energy integrations are compiled against other mods' jars, which are third-party
# binaries and stay out of the repository; libs/compat/README.md lists the seven files the build
# expects to find there.
libs/compat/*.jar
# Python (art/logo/make_logo.py)
__pycache__/
*.pyc
